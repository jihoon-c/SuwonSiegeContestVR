# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

###############################################################################
# ThirdParty SDK 바이너리 예외
#
# 위의 "Compiled Dynamic/Static libraries" 규칙은 빌드 산출물을 무시하기 위한
# 것이다. 하지만 외부에서 임포트하는 서드파티 SDK(예: 음성인식 모듈)의
# 사전 빌드 바이너리는 반드시 커밋되어야 한다.
#
# 따라서 ThirdParty 디렉토리 아래의 바이너리는 무시 대상에서 제외한다.
# 이 파일들은 .gitattributes에 의해 Git LFS로 관리된다.
###############################################################################
!Source/**/ThirdParty/**
!Plugins/**/Source/ThirdParty/**
!**/ThirdParty/**/*.so
!**/ThirdParty/**/*.a
!**/ThirdParty/**/*.lib
!**/ThirdParty/**/*.dll
!**/ThirdParty/**/*.dylib
